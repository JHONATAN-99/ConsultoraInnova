generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"   // can be changed to "mysql" later if desired
  url      = env("DATABASE_URL")
}

model Curso {
  id             Int          @id @default(autoincrement())
  nombre         String
  descripcion    String
  precio         Float
  duracionSemanas Int?
  estudiantes    Estudiante[]
  solicitudes     Solicitud[]
}

model Estudiante {
  id           Int      @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String
  cursoId      Int
  montoInicial Float
  curso        Curso    @relation(fields: [cursoId], references: [id])
}

model Solicitud {
  id       Int    @id @default(autoincrement())
  cursoId  Int
  usuario  String
  status   String

  curso    Curso  @relation(fields: [cursoId], references: [id])
}

